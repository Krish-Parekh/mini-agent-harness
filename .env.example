OPENAI_API_KEY=

# GitHub OAuth App (Settings -> Developer settings -> OAuth Apps).
# Callback URL must be: http://127.0.0.1:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Postgres (matches docker-compose.yml). Start it with: docker compose up -d db
DATABASE_URL=postgresql+psycopg://miniagent:miniagent@localhost:5432/miniagent
