OPENAI_API_KEY=
TAVILY_API_KEY=

SUPABASE_URL=https://your-project-ref.supabase.co

LANGFUSE_BASE_URL=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql+psycopg://miniagent:miniagent@localhost:5432/miniagent

# Sandbox: local | docker | e2b | daytona | modal | vercel | space
MINIAGENT_SANDBOX_PROVIDER=docker
MINIAGENT_SANDBOX_LIFETIME_S=3600
MINIAGENT_SANDBOX_IDLE_STOP_S=1800
MINIAGENT_SANDBOX_CPU=2
MINIAGENT_SANDBOX_MEMORY_MB=4096

# docker: build first with `docker build -t miniagent-sandbox:latest sandbox`
MINIAGENT_DOCKER_IMAGE=miniagent-sandbox:latest

# e2b
E2B_API_KEY=
MINIAGENT_E2B_TEMPLATE=

# daytona (optional image with git, setsid and timeout)
DAYTONA_API_KEY=
MINIAGENT_DAYTONA_IMAGE=

# modal
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MINIAGENT_MODAL_APP=miniagent

# vercel: VERCEL_OIDC_TOKEN, or VERCEL_TOKEN with VERCEL_TEAM_ID and VERCEL_PROJECT_ID
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# space (self-hosted Perplexity SPACE): SPACE_API_TOKEN, or an email and password to log in
SPACE_API_URL=
SPACE_DATA_PLANE_URL=
SPACE_API_TOKEN=
MINIAGENT_SPACE_EMAIL=
MINIAGENT_SPACE_PASSWORD=
MINIAGENT_SPACE_TEMPLATE=code-runtime:latest
MINIAGENT_SPACE_ALLOW_INTERNET=true
MINIAGENT_SPACE_EGRESS_PROFILES=
